# =============================================================================
# Task Manager API - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Server Configuration
PORT=3000

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://taskmanager:password@localhost:5432/taskmanager

# Authentication
# Generate a secure token for production: openssl rand -hex 32
API_TOKEN=dev-token-change-in-production

# Rate Limiting
# Maximum requests per minute per client
RATE_LIMIT_MAX=100
